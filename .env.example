# Copy to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Exa — search and retrieval. https://dashboard.exa.ai
EXA_API_KEY=YOUR_EXA_KEY

# Voxell — embeddings for reranking and dedupe.
VOXELL_API_KEY=YOUR_VOXELL_KEY

# Optional base URL overrides (defaults shown)
# EXA_BASE_URL=https://api.exa.ai
# VOXELL_BASE_URL=https://api.voxell.ai

# Set to 1 to opt into the live API tests (npm run test:live).
# VOXELL_LIVE_TEST=1
