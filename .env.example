# Copy to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Exa — search and retrieval. https://dashboard.exa.ai
EXA_API_KEY=YOUR_EXA_KEY

# Voxell — embeddings for reranking, dedupe, and clustering.
# VOXELL_API_KEY is preferred; FORGE_API_KEY and VOXELL_KEY are also accepted,
# because Voxell's own SDKs disagree about the name.
VOXELL_API_KEY=YOUR_VOXELL_KEY

# Embedding tier. Defaults to ultra-4k (4096d), which separates duplicates from
# same-topic articles with about twice the margin of turbo. turbo is 1024d and
# free forever; ultra-4k and pro bill per token.
# VOXELL_MODEL=ultra-4k

# Synthesis — set EITHER of these. Anthropic is used when both are present.
# https://platform.claude.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
# https://fireworks.ai
FIREWORKS_API_KEY=YOUR_FIREWORKS_KEY

# Optional base URL overrides (defaults shown)
# EXA_BASE_URL=https://api.exa.ai
# VOXELL_BASE_URL=https://api.voxell.ai
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Set to 1 to opt into the live API tests (npm run test:live).
# Each provider's live tests are gated independently.
# EXA_LIVE_TEST=1
# VOXELL_LIVE_TEST=1
# FIREWORKS_LIVE_TEST=1
