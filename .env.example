# Copy to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Exa — search and retrieval. https://dashboard.exa.ai
EXA_API_KEY=YOUR_EXA_KEY

# Voxell — embeddings for reranking, dedupe, and clustering.
VOXELL_API_KEY=YOUR_VOXELL_KEY

# Synthesis — set EITHER of these. Anthropic is used when both are present.
# https://platform.claude.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
# https://fireworks.ai
FIREWORKS_API_KEY=YOUR_FIREWORKS_KEY

# Optional base URL overrides (defaults shown)
# EXA_BASE_URL=https://api.exa.ai
# VOXELL_BASE_URL=https://api.voxell.ai
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Set to 1 to opt into the live API tests (npm run test:live).
# Each provider's live tests are gated independently.
# EXA_LIVE_TEST=1
# VOXELL_LIVE_TEST=1
# FIREWORKS_LIVE_TEST=1
